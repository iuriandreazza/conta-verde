# The role the server serves requests as: it owns nothing and has no BYPASSRLS, so the row-level policies apply to it
# (docs/adr/0093-row-level-security.md). docker compose creates it (deploy/postgres/create-app-role.sql).
DATABASE_URL=postgres://conta_verde_app:conta_verde_app@localhost:5432/conta_verde
# The role that owns the schema: the server migrates with it at start and lets the role above use what it made. The server
# refuses to start when DATABASE_URL's role owns the tables or bypasses the policies (ALLOW_PRIVILEGED_DATABASE_ROLE=true
# overrides that, and the second barrier is then gone).
DATABASE_MIGRATE_URL=postgres://conta_verde:conta_verde@localhost:5432/conta_verde
BIND_ADDR=127.0.0.1:3000
# Set to true when the API is served over HTTPS, so browsers only send the session cookie securely.
COOKIE_SECURE=false
# Where CNPJs are checked. `brasilapi` sends each registered CNPJ (never a CPF) to BrasilAPI, a free
# third-party service built on Receita Federal open data, which can see which companies you deal
# with and from which address. `off` keeps everything local: only the check digits are validated.
CNPJ_LOOKUP=brasilapi
# Where an address is looked up by its CEP, when the person asks for it in the party form.
# `brasilapi` sends that one CEP to BrasilAPI; `off` keeps it local and the address is typed.
CEP_LOOKUP=brasilapi
# E-mail (invitations, quotes, reminders), queued and sent by a worker that retries. Without SMTP_URL nothing is sent: the message is only written to the log.
# For development, `docker compose up -d mailpit` catches everything at http://localhost:8025.
# `pnpm dev` starts Mailpit and sets these for you. A server on the internet needs TLS:
# smtps://user:password@host:465, or smtp://user:password@host:587?tls=required (a URL with a password
# that does not encrypt is refused unless the server is localhost). An empty value is the same as unset.
# SMTP_URL=smtp://localhost:1025
# SMTP_FROM=conta-verde <no-reply@localhost>
# The link to the source code in the footer of every e-mail (AGPL section 13): a fork that runs modified code
# points it at its own source. Defaults to the upstream repository.
# SOURCE_URL=https://github.com/iuriandreazza/conta-verde
# Where the files attached to entries are kept. This directory holds the only copy of them: back it up
# with the database.
ATTACHMENTS_DIR=./data/attachments
# WhatsApp reminders through the WhatsApp Business Cloud API: all three or none. The template is one the
# provider approved, with a single body parameter (the reminder's text on one line). Never commit the token.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_TEMPLATE=
# Where the web app is, so the link in an invitation leads to it. It must be the address the web app
# really answers on: a link to another port opens whatever runs there (`pnpm dev` sets it for you).
PUBLIC_URL=http://localhost:5173
# `asaas` charges through Asaas (https://www.asaas.com): set ASAAS_API_KEY, and ASAAS_WEBHOOK_TOKEN (32 to 255
# characters, the same one the webhook is registered with at Asaas, which sends it back in the
# `asaas-access-token` header), and optionally ASAAS_API_URL (https://api-sandbox.asaas.com for the sandbox).
# Register https://YOUR-HOST/api/public/payments/COMPANY-ID/webhooks/asaas (the Cobrança page shows it) for
# the payment events. Never commit the key or the token.
# `stripe` charges through Stripe in Brazil: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (the endpoint's signing
# secret, whsec_...) and optionally STRIPE_API_URL. Register the same webhook address, with the events
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, checkout.session.completed and
# checkout.session.expired. The customer lands on PUBLIC_URL after a card page.
# DEVELOPMENT DEFAULT: `fake` makes charges that cannot be paid; set `off` or a real provider in production.
# Where charges (boleto, Pix, card link) are made. `off` (or unset) switches collection off: nothing is
# asked of anyone. `fake` makes charges up that cannot be paid, for development and demos. A real
# provider reads its own credentials from the environment and never stores them.
PAYMENT_PROVIDER=fake
# What the fake provider's webhooks are signed with (anyone with it can mark a fake charge as paid). Unset
# means a random one nobody knows: no webhook is accepted.
FAKE_PAYMENT_WEBHOOK_SECRET=fake-webhook-secret
# Fiscal documents (NF-e, later NFS-e and NFC-e), issued through a gateway that keeps the company's A1 certificate and
# talks to the tax authority. `off` (or unset) switches them off. `fake` makes documents up that have no fiscal value,
# for development. `focus` issues through Focus NFe (https://focusnfe.com.br): set FOCUS_NFE_TOKEN_HOMOLOGATION and/or
# FOCUS_NFE_TOKEN_PRODUCTION (the company's tokens at the gateway) and FOCUS_NFE_ISSUER_CNPJ (the one company this
# installation issues for: a token belongs to one company), and optionally FOCUS_NFE_API_URL. The certificate and its
# password are uploaded in the gateway's panel and never reach this server. Never commit the tokens.
# `nfeio` issues through NFE.io (https://nfe.io): set NFEIO_API_KEY (the invoice key), NFEIO_COMPANY_ID_HOMOLOGATION and/or
# NFEIO_COMPANY_ID_PRODUCTION (the company's id at the gateway) and NFEIO_ISSUER_CNPJ; optionally NFEIO_API_URL and
# NFEIO_FILE_HOSTS (hosts files may be served from, besides nfe.io and nfse.io). Issuing in production is refused until
# NFEIO_SEARCH_CONFIRMED=true, which you set only after the ignored sandbox test passed (docs/adr/0079-nfeio-adapter.md).
# An installation uses ONE gateway, the one you have an account with; the product works with either (docs/adr/0077-choosing-a-fiscal-gateway.md).
FISCAL_GATEWAY=fake
# Migration from the ERP you are leaving (scripts/erp-api-reader.py, docs/adr/0090-cloud-erp-api-reader.md): the credentials of the
# app registered with its API and the three addresses it publishes. ERP_OAUTH_URL is the authorization address with the redirect
# and scope the app was registered with. Used only by the scripts, never by the server; never commit the secret.
# ERP_CLIENT_ID=
# ERP_CLIENT_SECRET=
# ERP_OAUTH_URL=
# ERP_TOKEN_URL=
# ERP_API_URL=

# The public API v1 (docs/adr/0087-public-api-v1.md): how many requests a key may make a minute. It is counted in the memory of
# each process, so with several instances behind a balancer a key's real limit is that many times this.
# API_RATE_LIMIT_PER_MINUTE=300

# Webhooks (docs/adr/0088-webhooks.md) are off without FISCAL_SECRETS_KEY (their secrets are sealed with it). A webhook goes only to an
# https address on the public internet; this development and test opt-in lets it go to http and to private addresses (a listener on this
# machine). Never set it in production.
# WEBHOOK_ALLOW_PRIVATE_TARGETS=true

# Automatic bank statement sync (docs/adr/0089-bank-statement-sync.md): off, or an aggregator whose keys are this installation's.
# pluggy needs both keys; PLUGGY_API_URL is optional and must be https (or http on this machine). Never run against the real service by
# the tests; without it the OFX import is the way to bring a statement in.
# BANK_AGGREGATOR=pluggy
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
