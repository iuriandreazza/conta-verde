DATABASE_URL=postgres://conta_verde:conta_verde@localhost:5432/conta_verde
BIND_ADDR=127.0.0.1:3000
# Set to true when the API is served over HTTPS, so browsers only send the session cookie securely.
COOKIE_SECURE=false
# Where CNPJs are checked. `brasilapi` sends each registered CNPJ (never a CPF) to BrasilAPI, a free
# third-party service built on Receita Federal open data, which can see which companies you deal
# with and from which address. `off` keeps everything local: only the check digits are validated.
CNPJ_LOOKUP=brasilapi
# Where an address is looked up by its CEP, when the person asks for it in the party form.
# `brasilapi` sends that one CEP to BrasilAPI; `off` keeps it local and the address is typed.
CEP_LOOKUP=brasilapi
# E-mail (invitations). Without SMTP_URL nothing is sent: the message is only written to the log.
# For development, `docker compose up -d mailpit` catches everything at http://localhost:8025.
# `pnpm dev` starts Mailpit and sets these for you. A server on the internet needs TLS:
# smtps://user:password@host:465, or smtp://user:password@host:587?tls=required (a URL with a password
# that does not encrypt is refused unless the server is localhost). An empty value is the same as unset.
# SMTP_URL=smtp://localhost:1025
# SMTP_FROM=conta-verde <no-reply@localhost>
# Where the files attached to entries are kept. This directory holds the only copy of them: back it up
# with the database.
ATTACHMENTS_DIR=./data/attachments
# WhatsApp reminders through the WhatsApp Business Cloud API: all three or none. The template is one the
# provider approved, with a single body parameter (the reminder's text on one line). Never commit the token.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_TEMPLATE=
# Where the web app is, so the link in an invitation leads to it. It must be the address the web app
# really answers on: a link to another port opens whatever runs there (`pnpm dev` sets it for you).
PUBLIC_URL=http://localhost:5173
# `asaas` charges through Asaas (https://www.asaas.com): set ASAAS_API_KEY, and ASAAS_WEBHOOK_TOKEN (32 to 255
# characters, the same one the webhook is registered with at Asaas, which sends it back in the
# `asaas-access-token` header), and optionally ASAAS_API_URL (https://api-sandbox.asaas.com for the sandbox).
# Register https://YOUR-HOST/api/public/payments/COMPANY-ID/webhooks/asaas (the Cobrança page shows it) for
# the payment events. Never commit the key or the token.
# `stripe` charges through Stripe in Brazil: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (the endpoint's signing
# secret, whsec_...) and optionally STRIPE_API_URL. Register the same webhook address, with the events
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, checkout.session.completed and
# checkout.session.expired. The customer lands on PUBLIC_URL after a card page.
# DEVELOPMENT DEFAULT: `fake` makes charges that cannot be paid; set `off` or a real provider in production.
# Where charges (boleto, Pix, card link) are made. `off` (or unset) switches collection off: nothing is
# asked of anyone. `fake` makes charges up that cannot be paid, for development and demos. A real
# provider reads its own credentials from the environment and never stores them.
PAYMENT_PROVIDER=fake
# What the fake provider's webhooks are signed with (anyone with it can mark a fake charge as paid). Unset
# means a random one nobody knows: no webhook is accepted.
FAKE_PAYMENT_WEBHOOK_SECRET=fake-webhook-secret
