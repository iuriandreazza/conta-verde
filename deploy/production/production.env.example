# The settings of deploy/production/docker-compose.yml. Copy to production.env and fill in; never commit the copy.
# Every variable the server reads is listed, with what it means, in docs/operations/configuration.md.

# The release to run: a tag of the image (1.0.0), never `latest` or `dev`.
CONTA_VERDE_VERSION=

# The name people open the app at. It must point at this host before the proxy can get its certificate.
DOMAIN=

# Two passwords, different, long and random (for example `openssl rand -hex 24`): the owner of the schema, and the role the
# application serves requests as. The second is made when the database is first created; to change it later see
# docs/operations/configuration.md.
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# 64 hexadecimal characters (`openssl rand -hex 32`). Without it gateway settings and webhooks are off. Lose it and what it sealed
# cannot be opened: keep a copy with the backups, apart from them.
FISCAL_SECRETS_KEY=

# E-mail (invitations, quotes, reminders). Without both nothing is sent. A server on the internet needs TLS.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=conta-verde <no-reply@example.com>

# What the server asks other services. `off` keeps it all local.
# CNPJ_LOOKUP=brasilapi
# CEP_LOOKUP=brasilapi
# PAYMENT_PROVIDER=off
# FISCAL_GATEWAY=off
